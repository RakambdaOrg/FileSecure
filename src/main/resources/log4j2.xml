<?xml version="1.0" encoding="UTF-8"?>
<!-- No Log4j shutdown hook, so the run summary can still be logged from the application shutdown hook -->
<Configuration name="Default" status="warn" shutdownHook="disable">
    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout disableAnsi="false" pattern="%highlight{%date{ISO8601} %level [%thread] %logger{1.} - %message}%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="com.github.kokorin.jaffree" level="error" additivity="false">
            <AppenderRef ref="console"/>
        </Logger>
        <!-- Error lines printed by ffmpeg and ffprobe, also for files they handle; on failure they are part of the exception FileSecure logs -->
        <Logger name="com.github.kokorin.jaffree.process.BaseStdReader" level="off" additivity="false"/>
        <Logger name="net.iakovlev.timeshape" level="warn" additivity="false">
            <AppenderRef ref="console"/>
        </Logger>
        <Root level="info" additivity="false">
            <AppenderRef ref="console"/>
        </Root>
    </Loggers>
</Configuration>
